{
  "manifest_version": 3,
  "name": "AuraMaxxing",
  "version": "3.3",
  "description": "Extra features for OpenFront.",
  "content_scripts": [
    {
      "matches": ["https://*.openfront.io/*", "http://localhost/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.openfront.io/*", "http://localhost/*"],
      "js": ["src/world/gameBridge.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/*"],
      "matches": ["https://*.openfront.io/*", "http://localhost/*"]
    }
  ],
  "permissions": ["declarativeNetRequest"],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "auramaxxing-admiral",
        "enabled": true,
        "path": "src/api/admiralRules.json"
      }
    ]
  }
}
