{
  "manifest_version": 3,
  "name": "AuraMaxxing",
  "version": "0.2.0",
  "description": "Extra features for OpenFront.",
  "content_scripts": [
    {
      "matches": ["https://*.openfront.io/*", "http://localhost/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.openfront.io/*", "http://localhost/*"],
      "js": ["src/world/gameBridge.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/*"],
      "matches": ["https://*.openfront.io/*", "http://localhost/*"]
    }
  ]
}
